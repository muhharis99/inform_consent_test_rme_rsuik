        'kd_bangsal' => $kode_bangsal, 
        'tgl_dibuat' => date("Y-m-d"),
        'jam_dibuat' => date("H:i:s"), 
        'tgl_dicetak' => date("Y-m-d"),
        'jam_dicetak' => date("H:i:s"), 
