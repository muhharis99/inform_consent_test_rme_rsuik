$tgl_masuk           = substr($this->input->post('tgl_periksa'), 6, 4)."-".substr($this->input->post('tgl_periksa'), 3, 2)."-".substr($this->input->post('tgl_periksa'), 0, 2);
$jam_masuk           = $this->input->post('jam_periksa');
