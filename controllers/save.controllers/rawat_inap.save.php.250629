/* simpan akad */
$sekarang = date("Y-m-d"); 
$str_table = ""; 
switch ($kode_asuransi_ri) {
    case '300' : 
    case '301' : 
    case '302' : 
    case '303' : 
    case '306' : 
        /*
        if ($tgl_dirawat!=$sekarang) {
            $str_table = "rsik.cetak_akad_bpjs_mutasi";
        } else {
            */
        if ($kelas_perawatan == 'MUTASI') {
            $str_table = "rsik.cetak_akad_bpjs_mutasi";
        } else {
            if ($hak_kelas!=$kelas_perawatan) {
                /* naik kelas */
                $str_table = "rsik.cetak_akad_bpjs_".strtolower($kelas_perawatan);
                if ($hak_kelas=='II' && $kelas_perawatan=='VIP') {
                    $str_table = "rsik.cetak_akad_bpjs_ii_".strtolower($kelas_perawatan);
                }
            } else {
                /* sesuai kelas */
                $str_table = "rsik.cetak_akad_bpjs";
            }
        }
        break; 
    case '000' : 
    case '001' :
        $str_table = "rsik.cetak_akad_umum";
        break; 
    default : 
        $str_table = "rsik.cetak_akad_asuransi";
        break;
}
if ($str_table!="") {
    /* get pekerjaan penanggung jawab */
