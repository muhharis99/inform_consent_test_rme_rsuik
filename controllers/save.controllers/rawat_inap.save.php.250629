    "nama" => $nama
]);
/* get poliklinik sesuai DPJP */
$poli_dpjp = DB::table('rme.dokter as a')
    ->leftJoin('rsiklaten.poli as b', function ($join) {
        $join->on('a.kd_poli', '=', 'b.kode_poli');
    })
    ->where('a.kd_dokter', $dpjp_1)
    ->where('b.report_status', 1)
    ->where('b.report_nama', '!=', 'EKSEKUTIF')
    ->whereNotIn('a.kd_poli', array('ODC', 'GCU'))
    ->first(array('a.kd_poli'));
if (!empty($poli_dpjp)) {
    $poli_dpjp = (object) $poli_dpjp;
    $kode_poli_dpjp = $poli_dpjp->kd_poli;
}
/* update kunjung */
if ((string) $id_kunjung != "") {
    $kunjung = Kunjung::where('id', $id_kunjung); 
// pre($kunjung);
    savelog($no_reg, "rsiklaten", "kunjung", $kunjung, $writer);
    DB::transaction(function () use ($kunjung, &$dpjp_1, &$dpjp_2, &$dpjp_3) {
        $kunjung->update(array('kd_dr_ri1' => $dpjp_1, 'kd_dr_ri2' => $dpjp_2, 'kd_dr_ri3' => $dpjp_3, 'rawat' => 'G'));
    });
}
/** simpan di dfrm/penyimpanan */
/** get data lama */
if (!empty($id_kunjung)) {
    $dfrm = DB::table('rsiklaten.dfrm')->where('id_kunjung', $id_kunjung)->where('deletedstate', 0)->first();
    savelog($no_reg, "rsiklaten", "dfrm", $dfrm, $writer);
    if (!empty($dfrm)) {
        $dfrm = (object) $dfrm;
        $id_dfrm = $dfrm->id;
        /** update data dfrm lama */
        $status_baru = $dfrm->status_baru;
        if (in_array($dfrm->kd_poli, ['UGD', 'PNEK'])) { $status_baru = 0; } else { $status_baru = 2; } 
        DB::table('rsiklaten.dfrm')->where('id', $id_dfrm)
        ->update([
            'kd_dr' => $dpjp_1, 
            'status_baru' => $status_baru
        ]);
    } else {
        /** insert new record */
        $kunjung = Kunjung::where('id', $id_kunjung)->first(['kd_poli']); 
        DB::table('rsiklaten.dfrm')->insert(array(
            'id_kunjung' => $id_kunjung,
            'tanggal' => $tgl_dirawat,
            'jam' => $jam_dirawat,
            'no_reg' => $no_reg,
            'nama' => $nama,
            'kd_poli' => !empty($kunjung['kd_poli'])?$kunjung['kd_poli']:$kode_poli_dpjp,
            'kd_dr' => $dpjp_1,
            'status_baru' => 0
        ));    

    }
} else {
    /** insert new record */
    DB::table('rsiklaten.dfrm')->insert(array(
        'id_kunjung' => $id_kunjung,
        'tanggal' => $tgl_dirawat,
        'jam' => $jam_dirawat,
        'no_reg' => $no_reg,
        'nama' => $nama,
        'kd_poli' => $kode_poli_dpjp,
        'kd_dr' => $dpjp_1,
        'status_baru' => 2
    ));    
}

