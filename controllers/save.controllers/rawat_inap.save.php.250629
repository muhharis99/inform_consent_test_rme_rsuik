$telp_darurat_1       = $this->input->post('telp_darurat_1');
$hub_darurat_1        = $this->input->post('hub_darurat_1');
$nama_darurat_2       = $this->input->post('nama_darurat_2');
$alamat_darurat_2     = $this->input->post('alamat_darurat_2');
$umur_darurat_2       = $this->input->post('umur_darurat_2');
$telp_darurat_2       = $this->input->post('telp_darurat_2');
$hub_darurat_2        = $this->input->post('hub_darurat_2');
$nama_darurat_3       = $this->input->post('nama_darurat_3');
$alamat_darurat_3     = $this->input->post('alamat_darurat_3');
$umur_darurat_3       = $this->input->post('umur_darurat_3');
$telp_darurat_3       = $this->input->post('telp_darurat_3');
$hub_darurat_3        = $this->input->post('hub_darurat_3');
$registered           = date("Y-m-d H:i:s");
// pre($tgl_mulai_admisi);

if (empty($no_reg)||$no_reg=='') die('c');

if (!empty($status_bayi)&&$status_bayi!="") {
    /** kasus bayi baru lahir didaftarkan sebelum ibunya lahir, tgl masuk dan jam masuk disesuaikan dengan tgl mulai rawat inap (kunjung, inap, mutasi_ri) */
    /** kapan rm di entri */
    $ibu_anak = DB::table('rsiklaten.ibu_anak')->where('id', $status_bayi)->first();
    if (!empty($ibu_anak['submitted'])) {
        $old_kunjung = DB::table('rsiklaten.kunjung')->where('no_reg', $no_reg)->whereRaw("registered between date_add('".$ibu_anak['submitted']."', interval -1 hour) and date_add('".$ibu_anak['submitted']."', interval 1 hour)")->orderBy('id', 'asc')->first();
        $old_tgl_masuk = !empty($old_kunjung['tanggal']) ? $old_kunjung['tanggal'] : null;
        if (!empty($old_tgl_masuk)) {
            DB::table('rsiklaten.kunjung')->where('no_reg', $no_reg)->where('tanggal', $old_tgl_masuk)->whereNotNull('kunjung')
                ->update([
                    'tanggal' => $tgl_masuk,
                    'jam'     => $jam_masuk,
                ]);
            DB::table('rsiklaten.mutasi_ri')->where('no_reg', $no_reg)->where('tgl_masuk', $old_tgl_masuk)->whereNotNull('tgl_ri')->whereNull('deleted')
                ->update([
                    'tgl_masuk' => $tgl_masuk, 
                    'jam_masuk' => $jam_masuk,
                ]);
            DB::table('rsiklaten.inap')->where('no_reg', $no_reg)->where('tgl_masuk', $old_tgl_masuk)
                ->update([
                    'tgl_masuk' => $tgl_masuk, 
                    'jam_masuk' => $jam_masuk,
                ]);
        }
    }
}
// if (ipclient()==IPC) json($status_bayi);
// if (ipclient()==IPC) die();
/* cari kode kelas bangsal */ 
$bangsal = DB::table('rme.bangsal as a')->where('kd_bangsal', $kode_bangsal)->first(array('kd_kelas'));
$kode_kelas_bangsal = $kelas_perawatan;
$perujuk_nama       = $nama_perujuk;
$perujuk_alamat     = $alamat_perujuk;
$asal               = '';
$kd_dr              = '';
$kode_poli_dpjp     = "";
$kode_rujuk         = $cara_daftar;
// pre($bangsal);
if (!empty($bangsal)) {
    $bangsal = (object) $bangsal;
    $kode_kelas_bangsal = $bangsal->kd_kelas;
    if ($hak_kelas == "I" && in_array($kode_asuransi, ['303'])) $kode_kelas_bangsal = "I";
}
/* cari asal kunjungan */ 
if ((string) $id_kunjung != "") {
    $kunjung = DB::table('rsiklaten.kunjung as a')->where('id', $id_kunjung)->first();
    if (!empty($kunjung)) {
        $kunjung        = (object) $kunjung;
        $asal           = $kunjung->kd_poli;
        $kd_dr          = $kunjung->kd_dr;
        $tgl_masuk      = $kunjung->tanggal;
        $jam_masuk      = $kunjung->jam;
        $kode_poli_dpjp = $kunjung->kd_poli;
        $kode_rujuk     = $kunjung->rujuk;
        $perujuk = DB::table('rsiklaten.perujuk as a')
                        ->where('a.no_reg', $no_reg)
                        ->where('a.tgl_masuk', $tgl_masuk)
                        ->first(
                            array(DB::raw('a.nama as perujuk'), 'a.alamat')
                        );
        if (!empty($perujuk)) {
            $perujuk = (object) $perujuk;
            $perujuk_nama = $perujuk->perujuk;
            $perujuk_alamat = $perujuk->alamat;
        }
        /*
        DB::table('rme.askep_gd')->where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)->where('jam_masuk', $jam_masuk)
            ->update(array(
                'tgl_masuk' => $tgl_dirawat, 
                'jam_masuk' => $jam_dirawat
            ));
        */
    } 
} else {
    $poli_dpjp = DB::table('rme.dokter as a')
        ->leftJoin('rsiklaten.poli as b', function ($join) {
            $join->on('a.kd_poli', '=', 'b.kode_poli');
        })
        ->where('a.kd_dokter', $dpjp_1)
        ->where('b.report_status', 1)
        ->where('b.report_nama', '!=', 'EKSEKUTIF')
        ->whereNotIn('a.kd_poli', array('ODC', 'GCU'))
        ->first(array('a.kd_poli'));
    if (!empty($poli_dpjp)) {
        $poli_dpjp = (object) $poli_dpjp;
        $kode_poli_dpjp = $poli_dpjp->kd_poli;
    }
    /** simpan di database 14 */
    /** MULAI SIMPAN DATABASE 14  */
        $str_umur = strtoupper(str_replace(["/", " ", ", HAPPY BIRTHDAY", ",HAPPYBIRTHDAY"], "", $umur));
        $byl_umur = $umur;
        if (strpos($str_umur, ',') === false) {
            $byl_umur = (strpos($str_umur, 'TH') === false ? '0' : stristr($str_umur, 'TH', true)).".".(strpos($str_umur, 'BL') === false ? '0' : (strpos($str_umur, 'TH') === false ? stristr($str_umur, 'BL', true) : str_replace("TH", "", stristr(stristr($str_umur, 'TH'), 'BL', true)))).".".(strpos($str_umur, 'HR') === false ? '0' : str_replace(["TH", "BL"], "", stristr(stristr(stristr($str_umur, 'TH'), 'BL'), 'HR', true)));
        } else { 
            if (strpos($str_umur, 'TH, HAPPY BIRTHDAY')) {
                $byl_umur = stristr($str_umur, ',', true).str_replace(",", ".", stristr(stristr($str_umur, ','), 'TH, HAPPY BIRTHDAY', true)).".0";
            } else if (strpos($str_umur, 'TH')) {
                $byl_umur = stristr($str_umur, ',', true).str_replace(",", ".", stristr(stristr($str_umur, ','), 'TH', true)).".0";
            } else if (strpos($str_umur, 'BL')) {
                $byl_umur = "0.".stristr($str_umur, ',', true).str_replace(",", ".", stristr(stristr($str_umur, ','), 'BL', true));
            }
        }
        $master_asuransi = DB::connection('rsi_byl')->table('master_asuransi')->where('asuransi_kode', $kode_asuransi_ri)->first(['asuransi_id']);
        DB::connection('rsi_byl')->table('kunjung')->insert([
            "status_inden" => "TIDAK",
            "no_rm" => $no_reg,
            "umur" => $byl_umur,
            "tgl_masuk" => $tgl_dirawat,
            "jam_masuk" => $jam_dirawat,
            "antrian" => "1A000",
            "antrian_status" => "Belum",
            "poli_kd" => $kode_poli_dpjp,
            "dokter_kd" => $dpjp_1,
            "asuransi_id" => !empty($master_asuransi['asuransi_id'])?$master_asuransi['asuransi_id']:NULL,
            "jenis_kunjung" => "Lama",
            "kunjung_ke" => 0,
            "sts_inap" => 1,
            "sts_bill_rajal" => 0,
            "sts_pasien_resep" => 0,
            "sts_pasien_resep_inap" => 0,
            "sts_pasien_apd" => 0,
            "sts_jenazah" => 0,
            "sts_laborat" => 0,
            "sts_radiologi" => 0,
            "sts_bayar" => "Belum",
            "pulang" => 0,
            "tgl_pulang" => NULL,
            "jam_pulang" => NULL,
            "akuntan_kd" => 1,
            "sts_bayi_lahir" => 0,
            "deleted" => 0,
            "bpjs_antrian_send" => 0
        ]);
    /** SELESAI SIMPAN DATABASE 14 */

    $kunjung            = Kunjung::firstOrNew(array('no_reg' => $no_reg, 'tanggal' => $tgl_dirawat, 'jam' => $jam_dirawat));
    $kunjung->tanggal   = $tgl_dirawat;
    $kunjung->jam       = $jam_dirawat;
    $kunjung->no_kjg    = 1;
    $kunjung->rawat     = "I";
    $kunjung->no_reg    = $no_reg;
    $kunjung->kunjung   = "L";
    $kunjung->kd_poli   = $kode_poli_dpjp;
    $kunjung->kd_dr     = $dpjp_1;
    $kunjung->kd_dr_ri1 = $dpjp_1;
    $kunjung->kd_dr_ri2 = $dpjp_2;
    $kunjung->kd_dr_ri3 = $dpjp_3;
    $kunjung->umur      = $umur;
    $kunjung->rujuk     = $kode_rujuk;
    $kunjung->pasien    = $kode_asuransi_ri;
    $kunjung->opr       = $user;
    DB::transaction(function () use ($kunjung) {
        $kunjung->save();
    });
    $tgl_masuk = $tgl_dirawat;
    $jam_masuk = $jam_dirawat;

}
// pre($tgl_masuk);
/* cari data di mutasi ri */ 
$mutasi_ri = Mutasi_ri::where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)->whereNull('deleted')->first();
if (!empty($mutasi_ri)) {
    /* backup data */ 
    savelog($no_reg, "rsiklaten", "mutasi_ri", $mutasi_ri, $writer);
}


DB::table('rsiklaten.mutasi_ri')->where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)
        ->update(array(
            'deleted' => $registered, 
            'deletedby' => $user, 
            'deletedstate' => 1
        ));

$mutasi_ri = Mutasi_ri::firstOrNew(array('no_reg' => $no_reg, 'tgl_masuk' => $tgl_masuk, 'bangsal' => $kode_bangsal));
$mutasi_ri->id_kunjung            = $id_kunjung;
$mutasi_ri->tanggal               = $tgl_masuk.' '.$jam_masuk;
$mutasi_ri->tgl_masuk             = $tgl_masuk;
$mutasi_ri->jam_masuk             = $jam_masuk;
$mutasi_ri->no_reg                = $no_reg;
$mutasi_ri->ruang                 = $no_bed;
$mutasi_ri->bangsal               = $kode_bangsal;
$mutasi_ri->kelas                 = $hak_kelas;
$mutasi_ri->kelas_perawatan       = $kelas_perawatan;
$mutasi_ri->no_bed                = $no_bed;
$mutasi_ri->asal                  = $asal;
$mutasi_ri->kd_dr                 = $kd_dr;
$mutasi_ri->kd_dr_ri1             = $dpjp_1;
$mutasi_ri->kd_dr_ri2             = $dpjp_2;
$mutasi_ri->kd_dr_ri3             = $dpjp_3;
$mutasi_ri->kd_dr_ri4             = $dpjp_4;
$mutasi_ri->kd_dr_ri5             = $dpjp_5;
$mutasi_ri->jenis_kel             = $jenis_kelamin;
$mutasi_ri->asuransi              = $kode_asuransi_ri;
$mutasi_ri->umur                  = $umur;
$mutasi_ri->tgl_ri                = $tgl_dirawat;
$mutasi_ri->jam_ri                = $jam_dirawat;
$mutasi_ri->pjawab                = $nama_penanggung_jawab;
$mutasi_ri->almjawab              = $alamat_penanggung_jawab;
$mutasi_ri->hubjawab              = $hub_penanggung_jawab;
$mutasi_ri->tgl_lahir_pjawab      = $tgl_lahir_penanggung_jawab;
$mutasi_ri->jenis_kel_pjawab      = $jenis_kelamin_penanggung_jawab;
$mutasi_ri->no_telp_pjawab        = $no_telp_penanggung_jawab;
$mutasi_ri->no_ktp_pjawab         = $no_ktp_penanggung_jawab;
if (!empty($pekerjaan_penanggung_jawab)) {
    $mutasi_ri->pekerjaan_pjawab      = $pekerjaan_penanggung_jawab;
}
if (!empty($pekerjaan_penanggung_jawab_lain)) {
    $mutasi_ri->pekerjaan_pjawab_lain = $pekerjaan_penanggung_jawab_lain;
}
$mutasi_ri->pjamin                = $nama_darurat_1;
$mutasi_ri->almjamin              = $alamat_darurat_1;
$mutasi_ri->no_telp_pjamin        = $telp_darurat_1;
$mutasi_ri->nama_darurat_1        = $nama_darurat_1;
$mutasi_ri->alamat_darurat_1      = $alamat_darurat_1;
$mutasi_ri->umur_darurat_1        = $umur_darurat_1;
$mutasi_ri->no_telp_darurat_1     = $telp_darurat_1;
$mutasi_ri->hub_darurat_1         = $hub_darurat_1;
$mutasi_ri->nama_darurat_2        = $nama_darurat_2;
$mutasi_ri->alamat_darurat_2      = $alamat_darurat_2;
$mutasi_ri->umur_darurat_2        = $umur_darurat_2;
$mutasi_ri->no_telp_darurat_2     = $telp_darurat_2;
$mutasi_ri->hub_darurat_2         = $hub_darurat_2;
$mutasi_ri->nama_darurat_3        = $nama_darurat_3;
$mutasi_ri->alamat_darurat_3      = $alamat_darurat_3;
$mutasi_ri->umur_darurat_3        = $umur_darurat_3;
$mutasi_ri->no_telp_darurat_3     = $telp_darurat_3;
$mutasi_ri->hub_darurat_3         = $hub_darurat_3;
$mutasi_ri->petugas               = $user;
$mutasi_ri->registered            = $registered;
$mutasi_ri->deletedstate          = 0;
$mutasi_ri->deleted               = NULL;
DB::transaction(function () use ($mutasi_ri) {
    $mutasi_ri->save();
});

/* simpan respon time */
$respon_time_admisi = Respon_time_admisi::where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)->where('jam_masuk', $jam_masuk)->first();
if (!empty($respon_time_admisi)) {
    savelog($no_reg, "rsik", "respon_time_admisi", $respon_time_admisi, $writer);
}
$respon_time_admisi = Respon_time_admisi::firstOrNew(array('no_reg' => $no_reg, 'tgl_masuk' => $tgl_masuk, 'jam_masuk' => $jam_masuk));
$respon_time_admisi->tgl_masuk      = $tgl_masuk;
$respon_time_admisi->jam_masuk      = $jam_masuk;
$respon_time_admisi->no_reg         = $no_reg;
$respon_time_admisi->tgl_ri         = $tgl_dirawat;
$respon_time_admisi->jam_ri         = $jam_dirawat;
$respon_time_admisi->mulai_admisi   = $tgl_mulai_admisi;
$respon_time_admisi->selesai_admisi = $tgl_selesai_admisi;
$respon_time_admisi->writed         = $registered;
$respon_time_admisi->writer         = $writer;
$respon_time_admisi->deleted        = NULL;
DB::transaction(function () use ($respon_time_admisi) {
    $respon_time_admisi->save();
});
/** update perujuk */
switch ($kode_rujuk) {
    case '' : 
    case 1 : 
    case '1' : 
    case 0 : 
        break;
    default : 
        DB::table('rsiklaten.perujuk')->where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)
            ->update(array(
                'deleted' => $registered, 
                'deletedby' => $user, 
                'deletedstate' => 1
            ));
        DB::table('rsiklaten.perujuk')
            ->insert(array(
                'id_kunjung' => $id_kunjung, 
                'no_reg' => $no_reg, 
                'tgl_masuk' => $tgl_masuk, 
                'jam' => $jam_masuk, 
                'rsi' => $praktek_rsi, 
                'kd_dr' => $kode_dokter_perujuk, 
                'nama' => $nama_perujuk, 
                'alamat' => $alamat_perujuk
            ));    
        break;  
}
/* update data pasien */ 
$pasien = Pasien::find($no_reg); 
savelog($no_reg, "rsiklaten", "pasien", $pasien, $writer);
$pasien->tgl_masuk        = $tgl_dirawat;
$pasien->jam_masuk        = $jam_dirawat;
$pasien->tgl_ri           = $tgl_dirawat;
$pasien->jam_ri           = $jam_dirawat;
$pasien->jenis_kel        = $jenis_kelamin;
if (!empty($kode_agama)) $pasien->agama = $kode_agama;
if (!empty($kode_perkawinan)) $pasien->kawin = $kode_perkawinan;
$pasien->tgl_lahir        = $tgl_lahir;
$pasien->umur             = $umur;
$pasien->nama             = $nama;
if (strlen($ktp) > 10) {
    $pasien->no_id        = $ktp;
}
$pasien->alamat           = $alamat;
$pasien->telp             = $telp_1;
$pasien->telp2            = $telp_2;
$pasien->kd_dr_ri1        = $dpjp_1;
