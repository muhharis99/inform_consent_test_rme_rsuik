    DB::table('rsik.cetak_akad_bpjs_vip')->where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)->where('jam_masuk', $jam_masuk)
    ->update(array(
        'deleted' => $registered, 
        'deleted_by' => $user, 
        'deleted_state' => 1
    ));
    DB::table('rsik.cetak_akad_bpjs_ii_vip')->where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)->where('jam_masuk', $jam_masuk)
    ->update(array(
        'deleted' => $registered, 
        'deleted_by' => $user, 
        'deleted_state' => 1
    ));
    DB::table('rsik.cetak_akad_bpjs_vvip')->where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)->where('jam_masuk', $jam_masuk)
    ->update(array(
