    ));
    DB::table('rsik.cetak_akad_bpjs_mutasi')->where('no_reg', $no_reg)->where('tgl_masuk', $tgl_masuk)->where('jam_masuk', $jam_masuk)
    ->update(array(
        'deleted' => $registered, 
        'deleted_by' => $user, 
        'deleted_state' => 1
    ));
    DB::table($str_table)
    ->insert(array(
        'no_reg' => $no_reg, 
        'tgl_masuk' => $tgl_masuk, 
        'jam_masuk' => $jam_masuk, 
        'tgl_ri' => $tgl_dirawat, 
